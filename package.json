  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "eslint": "^9.10.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.0"
  }
}

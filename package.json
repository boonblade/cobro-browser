{
  "name": "cobro-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "cobro-browser": "dist/server.js" },
  "files": ["dist", "skills", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "fixtures:install": "npm ci --prefix test/fixtures/vite-app",
    "e2e": "npm run build && npm run fixtures:install && playwright test",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright-core": "^1.50.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "eslint": "^9.10.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.0"
  }
}
